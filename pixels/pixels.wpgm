import wollok.game.*
import pixelArt.*

program PixelArt {
	game.title("Pixel Art")
	game.height(25)
	game.width(25)
	game.cellSize(10)
	game.ground("white.png")
	
	// pixelArt.createCanvas()

	game.onClickDo { position => pixelArt.newPixelIn(position) }

	keyboard.space().onPressDo({ console.println(pixelArt.encode()) })
	
	game.start()
}
